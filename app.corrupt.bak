const words = [
  ['look forward to','期待，盼望','/lʊk ˈfɔːrwərd tuː/'],['be good at','擅长于','/bi ɡʊd æt/'],['take care of','照顾，照料','/teɪk ker əv/'],['give up','放弃','/ɡɪv ʌp/'],['make a difference','产生影响，有作用','/meɪk ə ˈdɪfrəns/'],['get along with','与……相处融洽','/ɡet əˈlɔːŋ wɪð/'],['break the ice','打破沉默，活跃气氛','/breɪk ði aɪs/'],['in the end','最后，终于','/ɪn ði end/'],['as soon as','一……就……','/æz suːn æz/'],['be proud of','为……感到自豪','/bi praʊd əv/'],['pay attention to','注意，关注','/peɪ əˈtenʃn tuː/'],['used to','过去常常','/juːst tuː/']
];
const state = { sound:true, practiceIndex:0, correct:0, reviewed:0, wins:+localStorage.getItem('cjWins')||0, room:null, channel:null, role:null, duelIndex:0, myScore:0, oppScore:0, duelTimer:null, hasAnswered:false, awaiting:false };
const $ = id => document.getElementById(id);
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active')); $(id).classList.add('active');}
function toast(text){const el=$('toast');el.textContent=text;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1800)}
function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function speak(text){if(state.sound && 'speechSynthesis' in window){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(text));}}
function updateHome(){const w=state.wins, progress=(w%10)*10; $('winCount').textContent=w;$('homeLevel').textContent=`${['青铜','白银','黄金','铂金','星钻'][Math.min(4,Math.floor(w/10))]} I · Lv.${Math.floor(w/10)+1}`;$('xpBar').style.width=progress+'%';$('xpText').textContent=`${w%10} / 10 场胜利`;$('reviewedCount').textContent=state.reviewed;$('accuracy').textContent=state.reviewed?Math.round(state.correct/state.reviewed*100)+'%':'—'}
function makeAnswers(answer){return shuffle([answer,...shuffle(words.filter(w=>w[1]!==answer)).slice(0,3).map(w=>w[1])]);}
function renderPractice(){const w=words[state.practiceIndex%words.length];$('practiceProgress').textContent=String(state.practiceIndex+1).padStart(2,'0')+' / 10';$('practiceLine').style.width=((state.practiceIndex+1)*10)+'%';$('practiceWord').textContent=w[0];$('practicePhonetic').textContent=w[2];$('practiceListen').onclick=()=>speak(w[0]);const box=$('practiceAnswers');box.innerHTML='';makeAnswers(w[1]).forEach(a=>{const b=document.createElement('button');b.className='answer';b.textContent=a;b.onclick=()=>answerPractice(b,a,w);box.append(b)});$('thinkBonus').textContent=Math.max(1,5-Math.floor(state.practiceIndex/3));}
function answerPractice(btn,answer,w){if(btn.parentElement.dataset.lock)return;btn.parentElement.dataset.lock='1';const yes=answer===w[1];state.reviewed++;if(yes){state.correct++;btn.classList.add('correct');speak(w[0]);toast('答对了！记忆值 +1');}else{btn.classList.add('wrong');[...btn.parentElement.children].find(x=>x.textContent===w[1]).classList.add('correct');toast('再想想，这题会更快回来');}setTimeout(()=>{state.practiceIndex++;if(state.practiceIndex>=10){toast(`本轮完成，正确 ${state.correct} 题`);state.practiceIndex=0;show('home');updateHome()}else{renderPractice();$('practiceAnswers').dataset.lock=''}},900)}
function roomCode(){return String(Math.floor(1000+Math.random()*9000))}
function openChannel(code){
  if(state.channel)state.channel.close();
  const fallback=()=>{const c=new BroadcastChannel('cijing-'+code);state.channel={postMessage:m=>c.postMessage(m),close:()=>c.close()};c.onmessage=e=>receive(e.data);};
  // Hosted through server.js: use real WebSocket rooms. Opening index.html directly still supports two-tab testing.
  if(location.protocol.startsWith('http')){try{const ws=new WebSocket(`${location.protocol==='https:'?'wss':'ws'}://${location.host}/ws?room=${code}`);let ready=false;ws.onopen=()=>ready=true;ws.onmessage=e=>receive(JSON.parse(e.data));ws.onerror=()=>{if(!ready)fallback()};state.channel={postMessage:m=>ws.readyState===1&&ws.send(JSON.stringify(m)),close:()=>ws.close()};}catch{fallback()}}else fallback();
}
function create(){const code=roomCode();state.room=code;state.role='host';openChannel(code);$('roomNumber').textContent=code;show('waiting');}
function join(){const code=$('roomInput').value.trim();if(!/^\d{4}$/.test(code))return toast('请输入 4 位房间号');state.room=code;state.role='guest';openChannel(code);state.channel.postMessage({type:'join'});setTimeout(()=>{if($('lobby').classList.contains('active'))toast('正在寻找房间…')},200);}
function receive(m){if(m.type==='join'&&state.role==='host'){state.channel.postMessage({type:'start', seed:Date.now()});startDuel();}if(m.type==='start'&&state.role==='guest')startDuel();if(m.type==='answer')remoteAnswer(m);if(m.type==='next') {state.duelIndex=m.index;state.myScore=m.scores[m.role==='host'?'guest':'host'];state.oppScore=m.scores[state.role];renderDuel();}if(m.type==='leave'){toast('对手已离开房间');endDuel(false)}}
function startDuel(){state.duelIndex=0;state.myScore=0;state.oppScore=0;show('duel');renderDuel();}
function renderDuel(){clearInterval(state.duelTimer);state.hasAnswered=false;state.awaiting=false;const w=words[state.duelIndex%words.length];$('duelWord').textContent=w[0];$('duelPhonetic').textContent=w[2];$('duelProgress').textContent=`第 ${state.duelIndex+1} / 10 题`;$('myScore').textContent=state.myScore+' 分';$('opponentScore').textContent=state.oppScore+' 分';$('duelStatus').textContent='倒计时结束前，快选择答案！';const box=$('duelAnswers');box.innerHTML='';makeAnswers(w[1]).forEach(a=>{const b=document.createElement('button');b.className='answer';b.textContent=a;b.onclick=()=>duelAnswer(b,a,w);box.append(b)});let left=12;$('duelClock').textContent=left;state.duelTimer=setInterval(()=>{left--;$('duelClock').textContent=left;if(left<=0){clearInterval(state.duelTimer);if(state.role==='host')advance();else $('duelStatus').textContent='本题无人作答，等待下一题…'}},1000)}
function duelAnswer(btn,answer,w){if(state.hasAnswered)return;state.hasAnswered=true;clearInterval(state.duelTimer);const correct=answer===w[1];btn.classList.add(correct?'correct':'wrong');if(correct)speak(w[0]);$('duelStatus').textContent=correct?'回答正确，等待下一题…':'回答错误，对手得 1 分';state.channel?.postMessage({type:'answer',correct,role:state.role});if(state.role==='host')setTimeout(()=>advance(correct?'host':state.role==='host'?'guest':'host'),800)}
function remoteAnswer(m){if(state.role==='host'){if(m.correct)advance(m.role);else advance('host');}else{$('duelStatus').textContent=m.correct?'对手抢答正确':'对手答错，你得 1 分';}}
function advance(winner){clearInterval(state.duelTimer);if(state.role!=='host')return;const scores={host:state.role==='host'?state.myScore:state.oppScore,guest:state.role==='host'?state.oppScore:state.myScore};if(winner)scores[winner]++;state.myScore=scores.host;state.oppScore=scores.guest;state.duelIndex++;if(state.duelIndex>=10){state.channel?.postMessage({type:'next',index:10,scores,role:'host'});endDuel(true,scores);return}state.channel?.postMessage({type:'next',index:state.duelIndex,scores,role:'host'});renderDuel();}
function endDuel(normal,scores){clearInterval(state.duelTimer);const my= scores?(state.role==='host'?scores.host:scores.guest):state.myScore, opp=scores?(state.role==='host'?scores.guest:scores.host):state.oppScore;const win=normal&&my>opp;$('finalMy').textContent=my;$('finalOpp').textContent=opp;$('resultEyebrow').textContent=win?'VICTORY':my===opp?'DRAW':'GAME OVER';$('resultTitle').textContent=win?'完美胜出！':my===opp?'旗鼓相当！':'下次再战！';$('resultText').textContent=win?'你赢得了这场词汇对决':normal?'保持练习，下一场赢回来':'本场对战已结束';$('resultMedal').textContent=win?'♛':my===opp?'◈':'↗';if(win){state.wins++;localStorage.setItem('cjWins',state.wins);$('rewardBox').textContent=`+ 1 胜场 · 距下一等级还差 ${10-state.wins%10} 场`;}else $('rewardBox').textContent='完成一场对战 · 继续积累实力';show('result');updateHome();}
function leave(){state.channel?.postMessage({type:'leave'});state.channel?.close();state.channel=null;show('home');}
document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{const to=b.dataset.go;if(to==='practice'){state.practiceIndex=0;state.correct=0;renderPractice()}if(to==='home')updateHome();show(to)});
$('soundToggle').onclick=()=>{state.sound=!state.sound;$('soundToggle').textContent=state.sound?'♬':'♩';toast(state.sound?'声音已开启':'声音已关闭')};$('createRoom').onclick=create;$('joinRoom').onclick=join;$('copyRoom').onclick=()=>navigator.clipboard?.writeText(state.room).then(()=>toast('房间号已复制'))||toast('房间号：'+state.room);$('leaveRoom').onclick=leave;window.addEventListener('beforeunload',()=>state.channel?.postMessage({type:'leave'}));updateHome();
