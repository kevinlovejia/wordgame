const bank=[['look forward to','期待，盼望','/lʊk ˈfɔːrwərd tuː/'],['be good at','擅长于','/bi ɡʊd æt/'],['take care of','照顾，照料','/teɪk ker əv/'],['give up','放弃','/ɡɪv ʌp/'],['make a difference','产生影响','/meɪk ə ˈdɪfrəns/'],['get along with','与……相处融洽','/ɡet əˈlɔːŋ wɪð/'],['break the ice','打破沉默','/breɪk ði aɪs/'],['in the end','最后，终于','/ɪn ði end/'],['as soon as','一……就……','/æz suːn æz/'],['be proud of','为……感到自豪','/bi praʊd əv/'],['pay attention to','注意，关注','/peɪ əˈtenʃn tuː/'],['used to','过去常常','/juːst tuː/'],['be interested in','对……感兴趣','/bi ˈɪntrəstɪd ɪn/'],['take part in','参加','/teɪk pɑːrt ɪn/'],['come true','实现，成为现实','/kʌm truː/'],['depend on','依靠，取决于','/dɪˈpend ɑːn/'],['be afraid of','害怕……','/bi əˈfreɪd əv/'],['make friends with','和……交朋友','/meɪk frendz wɪð/'],['be responsible for','对……负责','/bi rɪˈspɑːnsəbl fɔːr/'],['try one’s best','尽某人最大努力','/traɪ wʌnz best/'],['keep in touch with','与……保持联系','/kiːp ɪn tʌtʃ wɪð/'],['find out','查明，弄清','/faɪnd aʊt/'],['put off','推迟，延期','/pʊt ɔːf/'],['run out of','用完，耗尽','/rʌn aʊt əv/'],['make up one’s mind','下定决心','/meɪk ʌp wʌnz maɪnd/'],['take place','发生，举行','/teɪk pleɪs/'],['be different from','与……不同','/bi ˈdɪfrənt frəm/'],['instead of','代替，而不是','/ɪnˈsted əv/'],['at the same time','同时','/æt ðə seɪm taɪm/'],['be supposed to','应该，被期望','/bi səˈpoʊzd tuː/']];
const $=id=>document.getElementById(id), S={wins:+localStorage.cjWins||0,done:0,right:0,i:0,round:[],ws:null,role:null,room:null,question:null,answered:false,timer:null};
const shuffle=x=>[...x].sort(()=>Math.random()-.5), say=t=>{let x=$('toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),1700)}, speak=t=>{speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))};
function page(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));$(id).classList.add('active')}
function updateHome(){let n=S.wins;$('winCount').textContent=n;$('homeLevel').textContent=`${['青铜','白银','黄金','铂金'][Math.min(3,n/10|0)]} I · Lv.${(n/10|0)+1}`;$('xpBar').style.width=n%10*10+'%';$('xpText').textContent=`${n%10} / 10 场胜利`;$('reviewedCount').textContent=S.done;$('accuracy').textContent=S.done?Math.round(S.right/S.done*100)+'%':'—';$('mistakeCount').textContent=mistakes().length+' 个待复习'}
function mistakes(){try{return JSON.parse(localStorage.cjMistakes||'[]')}catch{return[]}}
function saveMistake(w){let all=mistakes().filter(x=>x[0]!==w[0]);all.unshift(w);localStorage.cjMistakes=JSON.stringify(all.slice(0,100))}
function options(w){return shuffle([w[1],...shuffle(bank.filter(x=>x[1]!==w[1])).slice(0,3).map(x=>x[1])])}
function buttons(list,box,callback){box.innerHTML='';list.forEach((a,i)=>{let b=document.createElement('button');b.className='answer';b.textContent=a;b.onclick=()=>callback(b,i,a);box.append(b)})}
function practice(){let w=S.round[S.i], locked=false;$('practiceProgress').textContent=String(S.i+1).padStart(2,'0')+' / 10';$('practiceLine').style.width=(S.i+1)*10+'%';$('practiceWord').textContent=w[0];$('practicePhonetic').textContent=w[2];$('practiceListen').onclick=()=>speak(w[0]);buttons(options(w),$('practiceAnswers'),(b,_i,a)=>{if(locked)return;locked=true;let yes=a===w[1];S.done++;if(yes){S.right++;b.classList.add('correct');speak(w[0]);say('答对了！记忆值 +1')}else{b.classList.add('wrong');saveMistake(w);[...$('practiceAnswers').children].find(x=>x.textContent===w[1]).classList.add('correct');say('已加入错题本')}setTimeout(()=>{S.i++;S.i===10?(S.i=0,page('home'),updateHome(),say('本轮练习完成')):practice()},850)})}
function review(){let all=mistakes();if(!all.length){$('mistakeHint').textContent='暂无错题，去练习模式试试吧';$('mistakeWord').textContent='太棒了！';$('mistakePhonetic').textContent='';$('mistakeAnswers').innerHTML='';return}let w=all[0],locked=false;$('mistakeHint').textContent=`剩余 ${all.length} 个待复习`;$('mistakeWord').textContent=w[0];$('mistakePhonetic').textContent=w[2];$('mistakeListen').onclick=()=>speak(w[0]);buttons(options(w),$('mistakeAnswers'),(b,_i,a)=>{if(locked)return;locked=true;if(a===w[1]){b.classList.add('correct');localStorage.cjMistakes=JSON.stringify(all.slice(1));say('掌握了，已移出错题本');setTimeout(review,700)}else{b.classList.add('wrong');say('再记一次');setTimeout(review,700)}})}
function connect(){let external=new URLSearchParams(location.search).get('server'),url=external?external.replace(/\/$/,'')+'/ws':(location.protocol==='https:'?'wss':'ws')+'://'+location.host+'/ws';S.ws=new WebSocket(url);S.ws.onopen=()=>S.ws.send(JSON.stringify({type:S.role==='host'?'create':'join',room:S.room}));S.ws.onmessage=e=>message(JSON.parse(e.data));S.ws.onerror=()=>say('无法连接服务器，请确认服务已启动');S.ws.onclose=()=>{if($('duel').classList.contains('active'))say('与服务器的连接已断开')}}
function create(){S.role='host';S.room=null;connect()}
function join(){let r=$('roomInput').value.trim();if(!/^\d{4}$/.test(r))return say('请输入 4 位房间号');S.role='guest';S.room=r;connect()}
function message(m){if(m.type==='room-created'){$('roomNumber').textContent=m.room;page('waiting')}else if(m.type==='error'){say(m.message);S.ws.close()}else if(m.type==='game-start'){page('duel')}else if(m.type==='question'){renderDuel(m)}else if(m.type==='answer-result'){if(m.correct)speak(S.question.word);$('duelStatus').textContent=m.text}else if(m.type==='game-over'){finish(m)}else if(m.type==='opponent-left'){say('对手已离开房间');page('home')}}
function renderDuel(q){S.question=q;S.answered=false;$('duelWord').textContent=q.word;$('duelPhonetic').textContent=q.phonetic;$('duelProgress').textContent=`第 ${q.number} / 10 题`;$('myScore').textContent=q.scores[S.role]+' 分';$('opponentScore').textContent=q.scores[S.role==='host'?'guest':'host']+' 分';$('duelStatus').textContent='倒计时结束前，快选择答案！';buttons(q.options,$('duelAnswers'),(b,index)=>{if(S.answered)return;S.answered=true;S.ws.send(JSON.stringify({type:'answer',index}));b.classList.add('selected')});clearInterval(S.timer);let end=q.endsAt;S.timer=setInterval(()=>{let left=Math.max(0,Math.ceil((end-Date.now())/1000));$('duelClock').textContent=left;if(!left)clearInterval(S.timer)},200)}
function finish(m){clearInterval(S.timer);let mine=m.scores[S.role],other=m.scores[S.role==='host'?'guest':'host'],win=mine>other;$('finalMy').textContent=mine;$('finalOpp').textContent=other;$('resultEyebrow').textContent=win?'VICTORY':mine===other?'DRAW':'GAME OVER';$('resultTitle').textContent=win?'完美胜出！':mine===other?'旗鼓相当！':'下次再战！';$('resultText').textContent='十题对决完成';if(win){S.wins++;localStorage.cjWins=S.wins;$('rewardBox').textContent=`+ 1 胜场 · 距下一等级还差 ${10-S.wins%10} 场`}else $('rewardBox').textContent='完成一场对战 · 继续积累实力';page('result');updateHome()}
document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{let to=b.dataset.go;if(to==='practice'){S.i=S.done=S.right=0;S.round=shuffle(bank).slice(0,10);practice()}if(to==='mistakes')review();if(to==='home')updateHome();page(to)});$('createRoom').onclick=create;$('joinRoom').onclick=join;$('copyRoom').onclick=()=>navigator.clipboard.writeText($('roomNumber').textContent).then(()=>say('房间号已复制'));$('leaveRoom').onclick=()=>{S.ws?.close();page('home')};$('rematch').onclick=()=>{if(S.ws&&S.ws.readyState===1)S.ws.send(JSON.stringify({type:'rematch'}));else {S.role='host';S.room=null;connect();say('正在创建新房间…')}};$('soundToggle').onclick=()=>say('使用浏览器系统发音');updateHome();
